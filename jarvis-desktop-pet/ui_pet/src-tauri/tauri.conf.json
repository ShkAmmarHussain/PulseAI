{
  "build": {
    "distDir": "../src",
    "devPath": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "JarvisDesktopPet",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": { "open": true },
      "window": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.jarvis.desktoppet",
      "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
      "externalBin": ["binaries/jarvis-backend"],
      "windows": { "wix": { "language": "en-US" } }
    },
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      },
      {
        "label": "pet",
        "title": "Jarvis Pet",
        "url": "pet.html",
        "width": 360,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "x": 1450,
        "y": 700
      },
      {
        "label": "dock",
        "title": "Jarvis Dynamic Island",
        "url": "dock.html",
        "width": 240,
        "height": 36,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  }
}